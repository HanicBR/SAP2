generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum GameMode {
  TTT
  SANDBOX
  MURDER
}

enum ServerStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum VipAutomationActionType {
  GRANT
  REVOKE
}

enum VipAutomationActionStatus {
  QUEUED
  FAILED
  SKIPPED
}

enum LoadingTelemetryEventType {
  SESSION_START
  HEARTBEAT
  STATUS_CHANGE
  FILE_DOWNLOAD
  STAGE_MARK
  SESSION_END
}

enum UserEmailTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  emailVerifiedAt DateTime?
  passwordHash String
  role         UserRole
  avatarUrl    String?
  steamId64    String?  @unique
  steamProfileUrl String?
  steamAvatarUrl String?
  steamPersonaName String?
  steamLinkedAt DateTime?
  steamLastSyncAt DateTime?
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())

  transactions Transaction[]
  emailTokens  UserEmailToken[]
  siteAuditLogs SiteAuditLog[]
}

model UserEmailToken {
  id        String            @id @default(cuid())
  userId    String
  type      UserEmailTokenType
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  metadata  Json?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([type, expiresAt])
}

model SiteAuditLog {
  id         String    @id @default(cuid())
  userId     String?
  username   String?
  userRole   UserRole?
  action     String
  method     String
  path       String
  statusCode Int
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([method, createdAt])
}

model SiteConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model GameServer {
  id             String       @id @default(cuid())
  name           String
  ip             String
  port           Int
  mode           GameMode
  status         ServerStatus @default(OFFLINE)
  currentPlayers Int          @default(0)
  maxPlayers     Int
  apiKeyHash     String?
  currentMap     String?
  lastHeartbeat  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  logs            Log[]
  playerSnapshots PlayerSnapshot[]
  playtimePulses  PlayerPlaytimePulse[]
}

model PlayerProfile {
  steamId          String       @id
  name             String
  avatarUrl        String?
  lastSeen         DateTime     @default(now())
  firstSeen        DateTime     @default(now())
  totalConnections Int          @default(0)
  playTimeHours    Int          @default(0)
  isVip            Boolean      @default(false)
  vipPlan          String?
  vipExpiry        DateTime?
  vipServerIds     String[]     @default([])
  ip               String?
  geo              Json?
  serverStats      Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  notes            PlayerNote[]
  punishments      Punishment[]
  ipHistory        PlayerIpHistory[]
  aliases          PlayerAliasHistory[]
  avatarHistory    PlayerAvatarHistory[]
}

model PlayerAliasHistory {
  id        String   @id @default(cuid())
  steamId   String
  name      String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  seenCount Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player PlayerProfile @relation(fields: [steamId], references: [steamId], onDelete: Cascade)

  @@unique([steamId, name], name: "steamId_name")
  @@index([steamId, lastSeen])
  @@index([name, lastSeen])
}

model PlayerAvatarHistory {
  id        String   @id @default(cuid())
  steamId   String
  avatarUrl String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  seenCount Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player PlayerProfile @relation(fields: [steamId], references: [steamId], onDelete: Cascade)

  @@unique([steamId, avatarUrl], name: "steamId_avatarUrl")
  @@index([steamId, lastSeen])
}

model VipAutomationAction {
  id              String                    @id @default(cuid())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  action          VipAutomationActionType
  status          VipAutomationActionStatus
  steamId         String
  vipPlan         String?
  vipExpiry       DateTime?
  serverId        String?
  command         String?
  metadata        Json?
  reason          String?
  queuedActionId  String?
  retryOfActionId String?
  retriedAt       DateTime?
  retries         Int                       @default(0)

  @@index([createdAt])
  @@index([steamId, createdAt])
  @@index([status, createdAt])
  @@index([retryOfActionId])
}

model GeoIpCache {
  ip           String   @id
  country      String?
  state        String?
  city         String?
  lat          Float?
  lng          Float?
  source       String?
  lastLookupAt DateTime?
  expiresAt    DateTime?
  failedCount  Int      @default(0)
  lastError    String?
  nextRetryAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
  @@index([nextRetryAt])
  @@index([updatedAt])
}

model PlayerIpHistory {
  steamId      String
  ip           String
  firstSeen    DateTime
  lastSeen     DateTime
  connections  Int      @default(0)
  lastServerId String?
  geoSnapshot  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player PlayerProfile @relation(fields: [steamId], references: [steamId], onDelete: Cascade)

  @@id([steamId, ip])
  @@index([steamId, lastSeen])
  @@index([ip, lastSeen])
}

model PlayerNote {
  id        String   @id @default(cuid())
  steamId   String
  content   String
  staffName String
  createdAt DateTime @default(now())

  player PlayerProfile @relation(fields: [steamId], references: [steamId], onDelete: Cascade)
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  VIP_SALE
  SERVER_HOSTING
  DOMAIN_WEB
  DEV_PLUGIN
  OTHER
}

model Transaction {
  id                String              @id @default(cuid())
  date              DateTime            @default(now())
  amount            Float
  type              TransactionType
  category          TransactionCategory
  description       String
  proofUrl          String?
  relatedSteamId    String?
  relatedPlayerName String?
  vipPlan           String?
  vipDurationDays   Int?
  createdBy         String
  createdAt         DateTime            @default(now())

  user User @relation(fields: [createdBy], references: [id])
}

enum PunishmentType {
  BAN
  MUTE
  GAG
  KICK
  WARN
}

model Punishment {
  id        String         @id @default(cuid())
  steamId   String
  type      PunishmentType
  reason    String
  staffName String
  date      DateTime       @default(now())
  duration  String?
  active    Boolean        @default(true)

  player PlayerProfile @relation(fields: [steamId], references: [steamId], onDelete: Cascade)
}

enum LogType {
  CONNECT
  DISCONNECT
  CHAT
  COMMAND
  PUNISH
  ULX
  KILL
  DAMAGE
  PROP_SPAWN
  TOOL_USE
  ROUND_START
  ROUND_END
  GAME_EVENT
}

model Log {
  id         String   @id @default(cuid())
  serverId   String
  eventId    String?
  gameMode   GameMode
  type       LogType
  timestamp  DateTime
  steamId    String?
  playerName String?
  rawText    String
  metadata   Json

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, eventId])
}

model PlayerSnapshot {
  id        String   @id @default(cuid())
  serverId  String
  timestamp DateTime @default(now())
  count     Int

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model PlayerPlaytimePulse {
  id             String   @id @default(cuid())
  serverId       String
  steamId        String
  bucketStart    DateTime
  grantedSeconds Int
  playerName     String?
  map            String?
  playerCount    Int?
  sentAt         DateTime?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, steamId, bucketStart], name: "serverId_steamId_bucketStart")
  @@index([serverId, bucketStart])
  @@index([steamId, bucketStart])
}

model LoadingTelemetrySession {
  id              String                 @id @default(cuid())
  sessionKey      String                 @unique
  slug            String
  source          String?
  startedAt       DateTime
  firstEventAt    DateTime?
  lastEventAt     DateTime?
  completedAt     DateTime?
  completed       Boolean                @default(false)
  totalDurationMs Int?
  lastStatus      String?
  lastFile        String?
  maxProgress     Int?
  userAgent       String?
  ipHash          String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  events          LoadingTelemetryEvent[]

  @@index([slug, startedAt])
  @@index([slug, createdAt])
  @@index([completed, startedAt])
}

model LoadingTelemetryEvent {
  id          String                   @id @default(cuid())
  sessionId   String
  seq         Int
  type        LoadingTelemetryEventType
  eventAt     DateTime
  statusText  String?
  fileName    String?
  progressPct Int?
  payload     Json?
  createdAt   DateTime                 @default(now())

  session LoadingTelemetrySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq], name: "sessionId_seq")
  @@index([sessionId, eventAt])
  @@index([type, eventAt])
}
